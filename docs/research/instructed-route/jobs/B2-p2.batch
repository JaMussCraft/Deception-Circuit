# instructed-route B2 P2, the SDR wish test (plans/B2-plan.md section 2; spec.md R3). U bound (the union of the
# six coarse v2 circuits minus m, at leaf), one model load. Every line is a neutral-twin interchange of the
# p2_groups.json groups (the L17H24-27 quartet, L17H24 alone, the seven other L17 KV groups and 20 random L17
# quartets) on the 618 reported-wish ids, --include-ids with --n-causal 1000 so the default of 100 cannot
# subsample. Primary positions: all. readout and after=pressure_clause,exclude=readout locate the effect and
# decide nothing. wish_* lines run the reported-wish stand-in (I-reported, twin sdr_v2_honest); sdrd_* lines run
# SDR D (sdr_v2) on the same ids as the pressure reference. Both write the cell U__leaf/sdr_v2, so every
# (condition, positions) pair has its own --output-dir.
# Written by B2 ticket T8 (hand-back reports/19-handback.md).
# Run from the worktree root:
#   sbatch --time=00:45:00 --partition=P --account=A scripts/analyze_components.sbatch batch \
#       docs/research/instructed-route/jobs/B2-p2.batch --timings outputs/_analyses/instructed-route-b2/timings/p2.json
# Login check: python analyze_components.py batch docs/research/instructed-route/jobs/B2-p2.batch --dry-run

# wish_all: reported wish (I-reported), positions all
--circuit Df=outputs/llama-8b-instruct_far_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-140717 --circuit Hf=outputs/llama-8b-instruct_far_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --circuit Ds=outputs/llama-8b-instruct_sdr_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-140323 --circuit Hs=outputs/llama-8b-instruct_sdr_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --circuit De=outputs/llama-8b-instruct_ser_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-173101 --circuit He=outputs/llama-8b-instruct_ser_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --circuit m=outputs/_launch_mechanism_v2/evals/operands/allmlp_nomb_v2 --expr 'U=(Df|Hf|Ds|Hs|De|He)-m' --compose-granularity leaf --reference far_D=outputs/llama-8b-instruct_far_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-140717 --reference far_H=outputs/llama-8b-instruct_far_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --reference sdr_D=outputs/llama-8b-instruct_sdr_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-140323 --reference sdr_H=outputs/llama-8b-instruct_sdr_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --reference ser_D=outputs/llama-8b-instruct_ser_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-173101 --reference ser_H=outputs/llama-8b-instruct_ser_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --task-from outputs/_launch_instructed_route/standins/sdr_v2_inversion_reported --seed 0 --include-ids docs/research/instructed-route/groups/sdr_wish_ids.txt --n-causal 1000 --analyses knockout --knockout-singles off --knockout-scheme interchange --knockout-counterfactual neutral_twin --knockout-positions all --knockout-groups docs/research/instructed-route/groups/p2_groups.json --output-dir outputs/_analyses/instructed-route-b2/p2/wish_all
