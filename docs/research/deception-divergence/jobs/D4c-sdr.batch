# D4(c) SDR job: B1's route closure on sdr_v2, so the SDR key-versus-query contrast (F-sdr-012 against F-rte-006)
# rests on the B1 code path and the R9 offline estimator. T1 (forward and offline sweeps, the D_q arms, controls C1 to
# C3, S_k) and T2 (every restore and reverse arm and control) plus the position-resolved path patching, on all 100
# held-out ids. Direction deception-divergence, rider D4(c) (START.md section 2 D4(c), spec.md D4 rules: replicate
# F-rte-006's rule, query share minus key share against 0.15, on SDR).
# Cloned from docs/research/instructed-route/jobs/B1-far.batch with sdr substituted. The composition part of the line
# (--circuit, --expr Ct=..., --compose-granularity leaf, --reference, --task-from) is copied verbatim from
# docs/research/mechanism-analysis/jobs/05-p3-sdr.batch, so the cell's Component set equals phase3/ct.json C_t for
# sdr (66 Components; tests/test_d4c_sdr_job.py).
# Held-out sample: the 100 ids of phase1/groups/sdr_heldout_D_sample.json (--include-ids, --n-causal 100).
# --route-ct names ct.json explicitly; the deciding set is sdr_heldout_D.json:greedy_k20 (20 Components).
# Path patching is on by default (--route-path-patching on). Written by hand; no generator script.
# Run from the repo root:  python analyze_components.py batch docs/research/deception-divergence/jobs/D4c-sdr.batch --timings outputs/_analyses/deception-divergence/d4c/timings/sdr.json
# Login check:            python analyze_components.py batch docs/research/deception-divergence/jobs/D4c-sdr.batch --dry-run
# Readings (CPU, after the job): python scripts/route_closure_readings.py outputs/_analyses/deception-divergence/d4c/sdr/Ct__leaf/sdr_v2/route_closure/route_closure.json --out-dir docs/research/deception-divergence/results/d4c

# sdr: C_t on sdr_v2 D, all 100 held-out ids
--circuit Df=outputs/llama-8b-instruct_far_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-140717 --circuit Hf=outputs/llama-8b-instruct_far_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --circuit Ds=outputs/llama-8b-instruct_sdr_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-140323 --circuit Hs=outputs/llama-8b-instruct_sdr_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --circuit De=outputs/llama-8b-instruct_ser_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-173101 --circuit He=outputs/llama-8b-instruct_ser_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --circuit m=outputs/_launch_mechanism_v2/evals/operands/allmlp_nomb_v2 --circuit X=outputs/_launch_mechanism_analysis/operands/skct_sdr --expr 'Ct=(((Df&Ds&De)|(Ds-Df-De)|((Ds-Hs)-(Df&Ds&De)))-m)|X' --compose-granularity leaf --reference far_D=outputs/llama-8b-instruct_far_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-140717 --reference far_H=outputs/llama-8b-instruct_far_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --reference sdr_D=outputs/llama-8b-instruct_sdr_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-140323 --reference sdr_H=outputs/llama-8b-instruct_sdr_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --reference ser_D=outputs/llama-8b-instruct_ser_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-173101 --reference ser_H=outputs/llama-8b-instruct_ser_v2_coarse/nls0.3_honest_noedge_noan_nomh_nomo_nomb_261021-140323 --reference x_sdr=outputs/_launch_mechanism_analysis/operands/skct_sdr --task-from outputs/llama-8b-instruct_sdr_v2_coarse/nls0.3_noedge_noan_nomh_nomo_nomb_261021-140323 --include-ids docs/research/mechanism-analysis/phase1/groups/sdr_heldout_D_sample.json --n-causal 100 --analyses route_closure --route-tests both --route-direction both --route-sweep both --route-ct docs/research/mechanism-analysis/phase3/ct.json --route-deciding-set docs/research/mechanism-analysis/phase1/groups/sdr_heldout_D.json:greedy_k20 --output-dir outputs/_analyses/deception-divergence/d4c/sdr
