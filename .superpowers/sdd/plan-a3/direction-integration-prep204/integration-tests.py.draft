@pytest.mark.parametrize('damage', [None, 'oversize-update', 'nonfinite-update'])
def test_prepared_costs_and_envelope_are_charged(case, damage):
    r = runtime(); r._PreparedPilotTarget
    c = case(prepared=True, original_admission=True, bounded_numeric_fixture=True)
    c.inject_failure(damage)
    if damage is not None:
        with pytest.raises(ValueError): c.run_pilot(r)
        assert c.completed_receipt_paths == []
    else:
        receipt = c.run_pilot(r)
        assert set(c.prepared_metadata_keys) <= c.keys_at_envelope_sizing
        projected = r.workload.project_cost(c.receipts(receipt), c.target_inventory, c.ledger,
            packing_proofs=c.packing_proofs(receipt), runtime_cost=c.startup_evidence)
        assert projected['projected_seconds'] == c.expected_projected_seconds_startup_and_final_once
        assert c.final_trace[-6:] == ['namespace-and-full-witness', 'fresh-live-and-deadline',
            'identity-alias-seal', 'final-deadline', 'bounded-writer', 'receipt-complete']
        assert c.target_read_count == 3 and c.target_parse_count == 1 and c.target_freeze_count == 1
        assert c.gpu_target_writes == []


def test_prepared_native_adapter_and_intake_preserve_scope(case):
    r = runtime(); r._PreparedPilotTarget
    c = case(prepared=True, original_admission=True, adapter_only=True)
    result = c.exercise_adapter_route_without_model()
    assert result['prepared_target_is_loader_minted'] is True
    assert result['case_ids'] == c.original_prefit_case_ids and len(result['case_ids']) == 9
    assert result['requires_all_cases_before_aggregate'] is True
    assert result['original_case_forwards_reexecuted'] is False
    assert result['new_reconciliation_work_is_actual'] is True


@pytest.mark.parametrize('damage', ['legacy-no-preparation', 'missing-preparation', 'changed-resource',
    'unanchored-resource', 'wrong-preparation-source', 'wrong-preparation-part'])
def test_prepared_migrated_intake_and_legacy_rejection(case, damage):
    r = runtime(); r._PreparedPilotTarget
    c = case(production_shaped_completed_fixture=True)
    c.damage_completed_origin(damage)
    with pytest.raises(ValueError):
        r._authenticated_pilot_receipts(c.design, c.protocol, c.target_inventory,
            [c.receipt_path], ledger_path=c.mapping_path)
    assert c.projector_calls == []
