@pytest.mark.parametrize('seam', ['guard-union', 'before-publication', 'final-live-guard'])
@pytest.mark.parametrize('damage', ['target-payload-restored-mtime', 'descriptor-marker', 'identical-target-tree'])
def test_prepared_final_barrier_after_all_costly_work(case, seam, damage):
    r = runtime(); r._PreparedPilotTarget
    c = case(prepared=True, original_admission=True, bounded_numeric_fixture=True)
    c.mutate_at(seam, damage)
    with pytest.raises(ValueError): c.run_pilot(r)
    assert c.receipt_writer_calls == []
    assert c.final_trace[:2] == ['guard-union', 'before-publication']


