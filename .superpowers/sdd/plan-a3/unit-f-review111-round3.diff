+        own=[]
+        for value in receipt.get('packing_evidence',{}).values():own.append(packed_reader(value['measured_path']).witness)
+        for value in receipt.get('serial_numeric_references',{}).values():own.append(serial_reader(value['path']).witness)
+        expected={str(Path(p).resolve()) for witness in own for p in witness.paths}
+        scenario=receipt.get('verification_scenario_reference')
