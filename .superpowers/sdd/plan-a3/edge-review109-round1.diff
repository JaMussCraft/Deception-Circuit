+def validate_h_bank(bank,expected):
+    """One contract for producer, cache, intervention and linked report intake."""
+    require(isinstance(bank,dict) and bank.get('contract')==expected,'H bank base/source/numeric contract differs')
+    require(bank.get('provenance')==expected['provenance'],'H bank ancestral provenance/weighting differs')
+    serialized=bank.get('values')
