+    for record in records:
+        require(isinstance(record,dict) and set(record)=={'site','value'},'malformed H bank sender record')
+        site=_bank_site(record['site'],expected['geometry'])
+        require(site in wanted and site not in seen,'duplicate/missing/extra H bank sender support')
+        seen.add(site)
+        try:value=torch.as_tensor(record['value'],dtype=torch.float32,device='cpu').detach()
