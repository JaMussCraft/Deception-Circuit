+    require(isinstance(dtype,str) and dtype.removeprefix('torch.') in ('float32','bfloat16','float16'),'known native H bank dtype required')
+    dtype='torch.'+dtype.removeprefix('torch.')
+    if numeric.get('dtype') is not None:require(dtype.removeprefix('torch.')==numeric['dtype'].removeprefix('torch.'),'H bank native dtype differs from frozen profile')
+    if numeric.get('backend') is not None:require(backend==numeric['backend'],'H bank backend differs from frozen profile')
+    require(isinstance(backend,str) and backend,'known native H bank backend required')
+    declared=[_bank_site(s,geometry) for s in design['tasks'][task]['edge_nodes']]
