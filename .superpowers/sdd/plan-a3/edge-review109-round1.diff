+    # cannot be collapsed into apparently complete support.
+    result=dict(values=dict(validated),contract=copy.deepcopy(expected),provenance=copy.deepcopy(expected['provenance']))
+    if 'reference' in bank:result['reference']=copy.deepcopy(bank['reference'])
