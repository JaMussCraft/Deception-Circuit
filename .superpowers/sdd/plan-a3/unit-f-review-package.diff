+def _mask_branch(row):
+    mask=row['mask']; n=sum(mask)
+    require(mask==[1]*n+[0]*(len(mask)-n),'reuse requires validated right padding')
+    return 'unmasked' if n==len(mask) else 'right-padded'
+
