+def _publish_prepared_target_object(path, payload):
+    """Publish ordinary operational bytes, binding the bytes emitted by this call.
+
+    This is data publication only. A completed object or descriptor does not
+    grant execution permission. Keep the generic publisher's JSON format.
+    """
+    emitted=(json.dumps(payload,sort_keys=True,allow_nan=False)+'\n').encode('utf-8')
+    emitted_hash=hashlib.sha256(emitted).hexdigest()
+    def writer(root):
+        (root/'payload.json').write_bytes(emitted)
+        artifacts._finish(root)
+    common.publish(Path(path),writer)
+    reference=object_reference(path)
+    require(reference['files']['payload.json']==dict(sha256=emitted_hash,nbytes=len(emitted)),
+        'prepared publication differs from emitted payload bytes')
+    return dict(reference=reference,emitted_payload_sha256=emitted_hash,emitted_payload_bytes=len(emitted))
