+def _prepared_object_stats(root):
+    """Capture exact ordinary root/leaf identities without reading payload bytes."""
+    import stat
+    root=Path(root)
+    require(stat.S_ISDIR(root.lstat().st_mode),'prepared object root must be ordinary')
+    require({child.name for child in root.iterdir()}=={'payload.json','COMPLETE.json'},
+        'unexpected operational artifact children')
+    identities={name:_stat_identity(root/name) for name in ('COMPLETE.json','payload.json')}
+    require(all(stat.S_ISREG(value[2]) for value in identities.values()),
+        'prepared object children must be ordinary files')
+    return _stat_identity(root),identities
