+def _prepared_namespace_identity(work_dir, target_root, preparation_root, allowed_aliases):
+    """Entry-local directory/alias identity; unrelated sibling writes are legal.
+
+    Resolve each path component explicitly so links in link targets also belong
+    to the ordered alias policy. Directory identities omit size/mtime/ctime.
+    """
+    import stat
+    from collections import deque
+    try:
+        roots=tuple(_prepared_lexical_path(value) for value in (work_dir,target_root,preparation_root))
+        work,target,preparation=roots
+        require(target.parent==work/'pilot-target-inventory'
+            and preparation.parent==work/'pilot-target-preparation' and target.name==preparation.name,
+            'prepared roots differ from canonical work-directory namespace')
+        expected=[]
+        for pair in allowed_aliases:
+            require(isinstance(pair,(tuple,list)) and len(pair)==2 and isinstance(pair[1],str),
+                'invalid prepared namespace alias policy')
+            expected.append((str(_prepared_lexical_path(pair[0])),pair[1]))
+        aliases=[];directories={};seen_aliases=set();resolved=[]
+        def directory(path,st):
+            require(stat.S_ISDIR(st.st_mode),'prepared namespace ancestor/root must be an ordinary directory')
+            identity=(st.st_dev,st.st_ino,stat.S_IFMT(st.st_mode))
+            key=str(path)
+            require(key not in directories or directories[key]==identity,'prepared namespace changed while resolving')
+            directories[key]=identity
+        for label,root in zip(('work_dir','target_root','preparation_root'),roots):
+            require(stat.S_ISDIR(root.lstat().st_mode),'prepared artifact/work roots must be ordinary directories')
+            current=Path(root.anchor);directory(current,current.lstat())
+            pending=deque(root.parts[1:]);hops=0
+            while pending:
+                part=pending.popleft()
+                if part in ('','.'):continue
+                if part=='..':current=current.parent;continue
+                child=current/part;st=child.lstat()
+                if stat.S_ISLNK(st.st_mode):
+                    hops+=1;require(hops<=40,'prepared namespace symlink cycle/depth')
+                    literal=os.readlink(child)
+                    row=(str(child),literal,_stat_identity(child))
+                    if str(child) not in seen_aliases:
+                        aliases.append(row);seen_aliases.add(str(child))
+                    else:
+                        require(next(item for item in aliases if item[0]==str(child))==row,
+                            'prepared namespace alias changed while resolving')
+                    link=Path(literal)
+                    if link.is_absolute():
+                        current=Path(link.anchor);directory(current,current.lstat());parts=link.parts[1:]
+                    else:parts=link.parts
+                    pending.extendleft(reversed(parts))
+                else:
+                    directory(child,st);current=child
+            resolved.append((label,str(root),str(current)))
+        require(tuple((path,literal) for path,literal,_ in aliases)==tuple(expected),
+            'prepared namespace contains unlisted/retargeted/reordered alias')
+        return (tuple(resolved),tuple(aliases),tuple(sorted(directories.items())))
+    except (OSError,RuntimeError,TypeError) as error:
+        raise ValueError('invalid or changed prepared namespace') from error
