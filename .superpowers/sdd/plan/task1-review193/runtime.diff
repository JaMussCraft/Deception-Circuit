+def _prepared_json_buffer(raw, temporaries):
+    """Parse the hashed bytes once and retain the actual decoder text for accounting."""
+    # _strict_json reads UTF-8 text; json.loads(bytes) otherwise also accepts UTF-16
+    # and BOM encodings that that existing text reader rejects.
+    require(json.detect_encoding(raw)=='utf-8','prepared JSON differs from existing UTF-8 text contract')
+    class Decoder(json.JSONDecoder):
+        def decode(self,text,*args,**kwargs):
+            temporaries.extend((self,text))
+            return super().decode(text,*args,**kwargs)
+    def reject(value):raise ValueError('nonfinite JSON value: '+value)
+    return json.loads(raw,cls=Decoder,parse_constant=reject)
+
