+@pytest.mark.parametrize("damage", ["payload", "manifest", "marker", "binding"])
+def test_a2_catalogue_stage_tamper_rejected(a2_catalogue_context, damage):
+    c = a2_catalogue_context
+    payload = dict(kind="software-stage", execution_provenance=None, counts={})
+    stage = c.output / "software-stage"
+    a2._publish_stage(stage, "payload.json", payload, a2._manifest(c.args, c.receipt, payload))
+    if damage == "marker":
+        (stage / "run_manifest.json").unlink()
+    elif damage == "payload":
+        (stage / "payload.json").write_text('{}')
+    elif damage == "manifest":
+        value = json.loads((stage / "run_manifest.json").read_text())
+        value["execution_commit"] = "0" * 40
+        (stage / "run_manifest.json").write_text(json.dumps(value))
+    else:
+        _catalogue_edit(c.catalogues[0], lambda data: data["directions"][0].update(title="changed"))
+    with pytest.raises((ValueError, KeyError)):
+        a2.read_stage(stage, "payload.json", "bank", c.args, c.receipt)
