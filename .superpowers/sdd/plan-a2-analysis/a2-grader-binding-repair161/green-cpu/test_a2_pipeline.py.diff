+@pytest.mark.parametrize("target", ["missing", "extra", "substitution", "same_buffer"])
+def test_a2_catalogue_original_observation_routes_rejected(a2_catalogue_context, monkeypatch, target):
+    c = a2_catalogue_context
+    original = a1.grader_registry
+    def changed():
+        value = original()
+        if target == "missing":
+            value.pop(next(iter(value)))
+        elif target == "extra":
+            value["unexpected"] = "0" * 64
+        elif target == "substitution":
