+@pytest.mark.parametrize("target", ["provenance", "binding_route", "binding_digest", "binding_type"])
+def test_a2_catalogue_frozen_binding_tamper_rejected(a2_catalogue_context, target):
+    c = a2_catalogue_context
+    receipt = copy.deepcopy(c.receipt)
+    if target == "provenance":
+        receipt["grader_registry"]["unexpected"] = "0" * 64
+    elif target == "binding_route":
+        receipt["grader_binding"]["routes"]["unexpected"] = {}
+    else:
+        record = next(iter(receipt["grader_binding"]["routes"].values()))
+        if target == "binding_digest":
+            record["sha256"] = "0" * 64
+        else:
+            record["own_entry"]["future_metadata"]["strict"] = 1
+            record["sha256"] = a2._catalogue_digest({k:v for k,v in record.items() if k != "sha256"})
+    receipt["receipt_sha256"] = a2.hash_content({k:v for k,v in receipt.items() if k != "receipt_sha256"})
+    with pytest.raises(ValueError):
+        a2._validate_live(c.args, receipt, c.prepared)
+
