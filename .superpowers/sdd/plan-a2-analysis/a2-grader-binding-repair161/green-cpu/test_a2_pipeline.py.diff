+def test_a2_catalogue_existing_stage_read_requires_no_rewrite(a2_catalogue_context):
+    c = a2_catalogue_context
+    payload = dict(kind="software-stage", execution_provenance=None, counts={})
+    manifest = a2._manifest(c.args, c.receipt, payload)
+    stage = c.output / "software-stage"
+    a2._publish_stage(stage, "payload.json", payload, manifest)
+    original = {p.name: p.read_bytes() for p in stage.iterdir()}
+    groups_bytes = (c.output / "groups.json").read_bytes()
+    for path in c.catalogues:
+        _catalogue_edit(path, lambda data: data["directions"][1].update(status="done"))
+    before = len(c.calls)
+    assert a2.read_stage(stage, "payload.json", "bank", c.args, c.receipt) == payload
+    assert len(c.calls) > before
+    assert {p.name: p.read_bytes() for p in stage.iterdir()} == original
+    assert (c.output / "groups.json").read_bytes() == groups_bytes
