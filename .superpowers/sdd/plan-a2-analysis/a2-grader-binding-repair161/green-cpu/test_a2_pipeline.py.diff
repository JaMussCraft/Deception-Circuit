+@pytest.mark.parametrize("change", ["foreign_metadata", "empty_row", "updated"])
+def test_a2_catalogue_unrelated_live_change_allowed(a2_catalogue_context, change):
+    c = a2_catalogue_context
+    frozen = copy.deepcopy(c.receipt["grader_registry"])
+    for path in c.catalogues:
+        def edit(data):
+            if change == "foreign_metadata":
+                data["directions"][1].update(status="active", title="changed")
+            elif change == "empty_row":
+                data["directions"].append(dict(id="new-empty", title="new",
+                    do_not_touch=[], archive=[], legacy_scratch=[], frozen_grader_sha256=None))
+            else:
+                data["updated"] = "2026-11-04"
+        _catalogue_edit(path, edit)
+    before = len(c.calls)
+    a2._validate_live(c.args, c.receipt, c.prepared)
+    assert len(c.calls) > before
+    assert c.receipt["grader_registry"] == frozen
+
