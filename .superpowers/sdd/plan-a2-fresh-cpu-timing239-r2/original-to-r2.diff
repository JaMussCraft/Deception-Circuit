+        # The actual current end can later increase; entry's shorter bound sticks.
+        end=1900. if allocation_calls['n']!=2 else current_end
+        return dict(end_epoch=end)
+    def packet(_):clock['now']=preentry_now
+    real_read=m.read_ref
