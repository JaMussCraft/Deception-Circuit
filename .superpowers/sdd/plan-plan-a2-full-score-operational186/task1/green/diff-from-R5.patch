+    profile = {k: v for k, v in os.environ.items() if k.startswith('SLURM_') or k == 'CUDA_VISIBLE_DEVICES'}
+    profile.update(A2_FULL_SCORE_BOUND_CONFIG=to_virtual(CONFIG), A2_FULL_SCORE_BOUND_CONFIG_SHA256=sha(CONFIG),
