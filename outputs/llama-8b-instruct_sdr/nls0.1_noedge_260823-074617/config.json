{
  "model": "llama-8b-instruct",
  "task": "sdr",
  "family": "llama",
  "std_variant": "azaria",
  "std_runtime_filter": false,
  "std_margin_loss": null,
  "deception_condition": "deceptive",
  "deception_runtime_filter": false,
  "deception_margin_loss": null,
  "edge_pruning": false,
  "skip_node_pruning": false,
  "seed": 42,
  "node_epochs": 500,
  "edge_epochs": 300,
  "lr": 0.03,
  "batch_size": 7,
  "max_seq_length": 120,
  "train_samples": 200,
  "val_samples": 200,
  "test_samples": 1000,
  "node_lambda_sparsity": 0.1,
  "edge_lambda_sparsity": 0.95,
  "faithfulness_weight": 1.0,
  "data_dir": "./data/datasets",
  "node_config": {
    "init_value": 0.5,
    "sparsity_warmup_steps": 1000,
    "depth_penalty_scaling": 0.0,
    "prune_attention_heads": true,
    "lambda_attention_heads": 1.0,
    "prune_attention_neurons": true,
    "lambda_attention_neurons": 1.0,
    "prune_attention_blocks": true,
    "lambda_attention_blocks": 1.0,
    "prune_mlp_hidden": true,
    "lambda_mlp_hidden": 1.0,
    "prune_mlp_output": true,
    "lambda_mlp_output": 1.0,
    "prune_mlp_blocks": true,
    "lambda_mlp_blocks": 1.0,
    "prune_full_layers": false,
    "lambda_full_layers": 1.0,
    "prune_embedding": false,
    "lambda_embedding": 1.0
  },
  "edge_config": {
    "sparsity_warmup_steps": 500,
    "include_output_edges": true
  }
}