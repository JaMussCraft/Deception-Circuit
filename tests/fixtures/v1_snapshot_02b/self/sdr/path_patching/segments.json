{
  "analysis": "path_patching",
  "pass": "position_specific",
  "circuit": "self",
  "task": "sdr",
  "counterfactual": "item_swap",
  "metric": {
    "quantity": "logit(Target) - logit(Distractor) at the Readout, fp32",
    "effect": "(clean - patched) / (clean - counterfactual), per instance",
    "counterfactual": "item_swap",
    "convention": "positive_helps_deception",
    "convention_version": 2,
    "sign": "positive means the path carries the clean stream (the prompt under its Pressure Clause) toward the deceptive answer, against the Corruption (the item swap); +1 is the whole clean-minus-counterfactual gap. Knockout's drop has the same sign (positive helps deception).",
    "min_gap": 0.001
  },
  "threshold": 0.05,
  "selection": "cells whose position-agnostic |mean| is at least 0.05",
  "n_selected": 6,
  "query_positions": [
    "readout"
  ],
  "position_rule": "K and V receivers take the patch at each Segment's key positions; Q, MLP and Readout receivers take it at the query positions",
  "union_check": "the Segments partition the prompt, so 'union' must reproduce 'agnostic'; 'sum_of_segments' is recorded for information and is not expected to, because a receiver's forward is not linear in its input",
