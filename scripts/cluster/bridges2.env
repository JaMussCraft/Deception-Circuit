# Cluster profile: PSC Bridges-2, a second GPU cluster dispatched from Delta (docs/bridges2.md).
# Sourced by scripts/evaluate_circuit.sbatch when DC_CLUSTER=bridges2, and by scripts/remote/b2.sh on Delta.
#
# Only H100 80 GB on GPU-shared: one GPU type per suite, and V100 cannot run the mgnp torch build (no sm_70).
# The environment is the conda-packed mgnp env unpacked under the project directory; ~/.bashrc is never
# copied to Bridges-2, so nothing here may depend on it. Model and wikitext come from a copied HF cache
# with the hub switched off.
#
# DC_B2_ALLOC is the allocation (charge) id printed by `projects` on Bridges-2. b2.sh also passes it into
# every job it submits, so a Bridges-2 clone that still holds an older copy of this file resolves the same paths.
export DC_CLUSTER_NAME="bridges2"
export DC_B2_ALLOC="${DC_B2_ALLOC:-__ALLOC__}"
export DC_B2_PROJECT="/ocean/projects/${DC_B2_ALLOC}/swong2"
export DC_ACCOUNT="${DC_B2_ALLOC}"
export DC_PARTITION="GPU-shared"
export DC_GPU_SPEC="--gpus=h100-80:1"
export DC_TIME_DEFAULT="01:00:00"
export DC_ENV_PREFIX="${DC_B2_PROJECT}/envs/mgnp"
export DC_ACTIVATE="source ${DC_ENV_PREFIX}/bin/activate"
export DC_HF_HOME="${DC_B2_PROJECT}/hf"
export DC_HF_OFFLINE="1"
export DC_REPO_ROOT="${DC_B2_PROJECT}/Deception-Circuit"
