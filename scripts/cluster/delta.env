# Cluster profile: NCSA Delta (the canonical cluster). Sourced by scripts/evaluate_circuit.sbatch when
# DC_CLUSTER is unset or "delta", by scripts/remote/b2.sh for the local paths, and by suite generators.
#
# These values reproduce the wrapper's behaviour before profiles existed: the #SBATCH header defaults
# (account, partition, one GPU, 12 h) and the mgnp activation through ~/.bashrc, which also sets
# HF_HOME to the same directory as DC_HF_HOME. Nothing here sets an offline flag.
#
# #SBATCH lines cannot read variables. DC_ACCOUNT, DC_PARTITION, DC_GPU_SPEC and DC_TIME_DEFAULT are for
# the sbatch command line (-A, -p, the GPU option, -t); only DC_ACTIVATE, DC_HF_HOME and DC_HF_OFFLINE act
# inside the job.
export DC_CLUSTER_NAME="delta"
export DC_ACCOUNT="beto-delta-gpu"
export DC_PARTITION="gpuA40x4"
export DC_GPU_SPEC="--gpus-per-node=1"
export DC_TIME_DEFAULT="12:00:00"
export DC_ACTIVATE="source ~/.bashrc && conda activate mgnp"
export DC_HF_HOME="/work/nvme/beto/swong2"
export DC_HF_OFFLINE="0"
# Host-side numerics: BLAS threads pinned to 1, as every Delta launcher (format-control, coarse SDR wave,
# ticket 05) already exported; shared with bridges2.env so both clusters run the same CPU-side math.
# This is the one deliberate change from the pre-profile wrapper (orchestrator, 2026-10-24).
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
# The checkout b2.sh syncs from and fetches into, and the one launchers treat as local. Override with
# DC_DELTA_REPO_ROOT (e.g. the main checkout once mechanism-analysis is merged).
export DC_REPO_ROOT="${DC_DELTA_REPO_ROOT:-/projects/beto/swong2/Alignment/Deception-Circuit/.claude/worktrees/mechanism-analysis}"
